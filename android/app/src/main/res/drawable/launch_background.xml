<?xml version="1.0" encoding="utf-8"?>
<!-- Vokey pre-Flutter launch window: dark brand background + icon. Avoids a white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/vokey_launch_background" />
    <item android:width="144dp" android:height="144dp" android:gravity="center">
        <bitmap android:src="@mipmap/ic_launcher" android:gravity="fill" />
    </item>
</layer-list>
