<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Launch window shown while the process starts (removed on first Flutter frame). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind Flutter while it initialises and runs. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/vokey_launch_background</item>
    </style>
</resources>
